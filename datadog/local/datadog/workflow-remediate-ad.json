{
  "name": "[otel demo] remediate ad latency (${ENV_NAME})",
  "description": "Act 3 of DEMO-SCRIPT.md, started by the ad latency monitor. Stage mode only (schedule paused by stage.sh): lift ad's CPU limit, wait, then roll back the adHighCpu flag that caused it. Runs on the otel-demo private action runner.",
  "spec": {
    "handle": "otel-demo-remediate-ad",
    "triggers": [
      {
        "monitorTrigger": {
          "rateLimit": {
            "count": 1,
            "interval": "600s"
          }
        },
        "startStepNames": [
          "Get_schedule"
        ]
      }
    ],
    "connectionEnvs": [
      {
        "env": "default",
        "connections": [
          {
            "connectionId": "${K8S_CONNECTION_ID}",
            "label": "INTEGRATION_KUBERNETES"
          },
          {
            "connectionId": "${FLAGD_CONNECTION_ID}",
            "label": "INTEGRATION_FLAGD"
          }
        ]
      }
    ],
    "steps": [
      {
        "name": "Get_schedule",
        "actionId": "com.datadoghq.kubernetes.apps.getDeployment",
        "connectionLabel": "INTEGRATION_KUBERNETES",
        "parameters": [
          {
            "name": "namespace",
            "value": "otel-demo"
          },
          {
            "name": "name",
            "value": "scenarios"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Stage_mode"
          }
        ]
      },
      {
        "name": "Stage_mode",
        "actionId": "com.datadoghq.core.if",
        "parameters": [
          {
            "name": "joinOperator",
            "value": "and"
          },
          {
            "name": "conditions",
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "{{ Steps.Get_schedule.spec.replicas }}",
                "rightValue": 0
              }
            ]
          }
        ],
        "outboundEdges": [
          {
            "branchName": "true",
            "nextStepName": "Lift_cpu_limit"
          }
        ]
      },
      {
        "name": "Lift_cpu_limit",
        "actionId": "com.datadoghq.kubernetes.apps.patchDeployment",
        "connectionLabel": "INTEGRATION_KUBERNETES",
        "parameters": [
          {
            "name": "namespace",
            "value": "otel-demo"
          },
          {
            "name": "name",
            "value": "ad"
          },
          {
            "name": "body",
            "value": [
              {
                "op": "add",
                "path": "/spec/template/spec/containers/0/resources/requests",
                "value": {
                  "cpu": "300m",
                  "memory": "300Mi"
                }
              },
              {
                "op": "remove",
                "path": "/spec/template/spec/containers/0/resources/limits/cpu"
              }
            ]
          },
          {
            "name": "fieldManager",
            "value": "datadog-workflow"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Event_cpu_lifted"
          }
        ]
      },
      {
        "name": "Event_cpu_lifted",
        "actionId": "com.datadoghq.dd.events.createEvent",
        "parameters": [
          {
            "name": "title",
            "value": "Workflow lifted ad CPU limit (ad)"
          },
          {
            "name": "text",
            "value": "The remediation workflow removed the ad container's 300m CPU limit (keeping a 300m request), ending CPU throttling. Latency recovers, but the load threads now take spare node CPU. The cause, the adHighCpu flag, is rolled back next."
          },
          {
            "name": "tags",
            "value": [
              "env:${ENV_NAME}",
              "service:ad",
              "source:workflow"
            ]
          },
          {
            "name": "alert_type",
            "value": "info"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Wait_for_recovery"
          }
        ]
      },
      {
        "name": "Wait_for_recovery",
        "actionId": "com.datadoghq.core.sleep",
        "parameters": [
          {
            "name": "durationSeconds",
            "value": 120
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Read_flags"
          }
        ]
      },
      {
        "name": "Read_flags",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "INTEGRATION_FLAGD",
        "parameters": [
          {
            "name": "verb",
            "value": "GET"
          },
          {
            "name": "url",
            "value": "http://flagd.otel-demo.svc.cluster.local:4000/api/read"
          },
          {
            "name": "responseParsing",
            "value": "json"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Flag_off"
          }
        ]
      },
      {
        "name": "Flag_off",
        "actionId": "com.datadoghq.datatransformation.func",
        "parameters": [
          {
            "name": "script",
            "value": "// flagd-ui replaces the whole flag file with what it is given, so send every flag.\nconst flags = _.cloneDeep($.Steps.Read_flags.body.flags);\nflags.adHighCpu.defaultVariant = 'off';\nreturn {data: {flags}};"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Write_flags"
          }
        ]
      },
      {
        "name": "Write_flags",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "INTEGRATION_FLAGD",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "http://flagd.otel-demo.svc.cluster.local:4000/api/write"
          },
          {
            "name": "body",
            "value": "{{ Steps.Flag_off.data }}"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "responseParsing",
            "value": "json"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Event_flag_rolled_back"
          }
        ]
      },
      {
        "name": "Event_flag_rolled_back",
        "actionId": "com.datadoghq.dd.events.createEvent",
        "parameters": [
          {
            "name": "title",
            "value": "Workflow rolled back adHighCpu to off (ad)"
          },
          {
            "name": "text",
            "value": "The remediation workflow rolled back the feature flag change that caused the ad latency alert: adHighCpu on to off."
          },
          {
            "name": "tags",
            "value": [
              "env:${ENV_NAME}",
              "service:ad",
              "source:workflow"
            ]
          },
          {
            "name": "alert_type",
            "value": "success"
          }
        ]
      }
    ]
  }
}
