{
  "name": "[otel demo] remediate ad latency (${ENV_NAME})",
  "description": "Act 3, on every ad latency alert (shared demo, no stage mode): open an incident if none is open for ad, wait 10 min (so the throttled pod stays visible in Kubernetes Explorer), then roll back adHighCpu, the change that caused it.",
  "spec": {
    "handle": "otel-demo-remediate-ad",
    "triggers": [
      {
        "monitorTrigger": {
          "rateLimit": {
            "count": 1,
            "interval": "1200s"
          }
        },
        "startStepNames": [
          "Find_open_incident"
        ]
      },
      {
        "apiTrigger": {},
        "startStepNames": [
          "Find_open_incident"
        ]
      }
    ],
    "connectionEnvs": [
      {
        "env": "default",
        "connections": [
          {
            "connectionId": "${REMEDIATOR_CONNECTION_ID}",
            "label": "INTEGRATION_REMEDIATOR"
          }
        ]
      }
    ],
    "steps": [
      {
        "name": "Find_open_incident",
        "actionId": "com.datadoghq.dd.incidents.searchIncidents",
        "parameters": [
          {
            "name": "query",
            "value": "state:(active OR stable) services:ad"
          },
          {
            "name": "page_size",
            "value": 1
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "None_open"
          }
        ]
      },
      {
        "name": "None_open",
        "actionId": "com.datadoghq.core.if",
        "parameters": [
          {
            "name": "joinOperator",
            "value": "and"
          },
          {
            "name": "conditions",
            "value": [
              {
                "comparisonOperator": "empty",
                "value": "{{ Steps.Find_open_incident.data.attributes.incidents }}"
              }
            ]
          }
        ],
        "outboundEdges": [
          {
            "branchName": "true",
            "nextStepName": "Declare_incident"
          },
          {
            "branchName": "false",
            "nextStepName": "Wait_before_fix"
          }
        ]
      },
      {
        "name": "Declare_incident",
        "actionId": "com.datadoghq.dd.incidents.createIncident",
        "parameters": [
          {
            "name": "customer_impacted",
            "value": false
          },
          {
            "name": "title",
            "value": "ad service latency: adHighCpu flag throttling the JVM (${ENV_NAME})"
          },
          {
            "name": "fields",
            "value": {
              "severity": {
                "type": "dropdown",
                "value": "SEV-3"
              },
              "services": {
                "type": "autocomplete",
                "value": [
                  "ad"
                ]
              }
            }
          },
          {
            "name": "initial_cells",
            "value": [
              {
                "cell_type": "markdown",
                "content": {
                  "content": "Declared by the remediation workflow from the ad latency monitor. Next: lift ad's CPU limit (symptom), then roll back adHighCpu (cause)."
                },
                "important": true
              }
            ]
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Wait_before_fix"
          }
        ]
      },
      {
        "name": "Wait_before_fix",
        "actionId": "com.datadoghq.core.sleep",
        "parameters": [
          {
            "name": "durationSeconds",
            "value": 600
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "Rollback_flag"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "Rollback_flag",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "INTEGRATION_REMEDIATOR",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "${REMEDIATOR_URL}/rollback-flag"
          },
          {
            "name": "responseParsing",
            "value": "json"
          }
        ],
        "errorHandlers": [
          {
            "retryStrategy": {
              "kind": "RETRY_STRATEGY_LINEAR",
              "linear": {
                "interval": "30s",
                "maxRetries": 4
              }
            },
            "fallbackStepName": "Rollback_failed"
          }
        ]
      },
      {
        "name": "Rollback_failed",
        "actionId": "com.datadoghq.core.sleep",
        "parameters": [
          {
            "name": "durationSeconds",
            "value": 1
          }
        ]
      }
    ]
  }
}
