{
  "title": "[otel demo] the :30 to :45 window (${ENV_NAME})",
  "description": "One widget per chapter of the presenter script. Every problem runs each hour between :30 and :45 UTC, each on its own service; markers are the scheduler's and the workflow's change events. Built from git by dd-apply.py.",
  "layout_type": "ordered",
  "widgets": [
    {"definition": {"type": "note", "background_color": "white", "font_size": "14", "text_align": "left", "show_tick": false, "has_padding": true,
      "content": "**Each hour, UTC.** :30 ad CPU (Ch 1) · :31 payment errors (Ch 2) · :32 agent loop (Ch 4) · :33 slow images (Ch 3) · :35 to :41 Kafka lag (Ch 5) · :38 to :44 email OOM (Ch 6) · :42 to :45 PostgreSQL lock (Ch 5). Everything ends by :45; the workflow rolls ad back after its alert. Pin the time picker to one window."}},
    {"definition": {"type": "timeseries", "title": "Ch 1 · ad GetAds p95 (s), per minute",
      "requests": [{"response_format": "timeseries", "display_type": "line",
        "queries": [{"data_source": "metrics", "name": "p95", "query": "p95:trace.grpc.server.request{env:${ENV_NAME},service:ad}.rollup(avg, 60)"}],
        "formulas": [{"formula": "p95"}]}],
      "markers": [{"value": "y = 0.02", "display_type": "error dashed", "label": "alert"}],
      "events": [{"q": "tags:env:${ENV_NAME} (source:scenarios OR source:remediation)"}]}},
    {"definition": {"type": "timeseries", "title": "Ch 2 · payment errors per minute",
      "requests": [{"response_format": "timeseries", "display_type": "bars",
        "queries": [{"data_source": "metrics", "name": "err", "query": "sum:trace.grpc.server.request.errors{env:${ENV_NAME},service:payment}.as_count()"}],
        "formulas": [{"formula": "err"}]}],
      "events": [{"q": "tags:env:${ENV_NAME},service:payment source:scenarios"}]}},
    {"definition": {"type": "timeseries", "title": "Ch 3 · product images over 3 s in real browsers (RUM)",
      "requests": [{"response_format": "timeseries", "display_type": "bars",
        "queries": [{"data_source": "rum", "name": "slow", "indexes": ["*"], "compute": {"aggregation": "count"}, "group_by": [],
          "search": {"query": "@type:resource env:${ENV_NAME} @resource.url_path:*images* @resource.duration:>3000000000"}}],
        "formulas": [{"formula": "slow"}]}]}},
    {"definition": {"type": "timeseries", "title": "Ch 4 · agent spans per minute",
      "requests": [{"response_format": "timeseries", "display_type": "bars",
        "queries": [{"data_source": "metrics", "name": "spans", "query": "sum:trace.Internal.hits{env:${ENV_NAME},service:agent}.as_count()"}],
        "formulas": [{"formula": "spans"}]}]}},
    {"definition": {"type": "timeseries", "title": "Ch 5 · Kafka consumer lag, fraud-detection",
      "requests": [{"response_format": "timeseries", "display_type": "line",
        "queries": [{"data_source": "metrics", "name": "lag", "query": "max:kafka.consumer_group.lag{group:fraud-detection}"}],
        "formulas": [{"formula": "lag"}]}]}},
    {"definition": {"type": "timeseries", "title": "Ch 5 · locks on catalog.products, by mode (postgresql receiver)",
      "requests": [{"response_format": "timeseries", "display_type": "bars",
        "queries": [{"data_source": "metrics", "name": "locks", "query": "max:postgresql.database.locks{relation:products} by {mode}"}],
        "formulas": [{"formula": "locks"}]}]}},
    {"definition": {"type": "timeseries", "title": "Ch 5 · product-catalog p95 (s)",
      "requests": [{"response_format": "timeseries", "display_type": "line",
        "queries": [{"data_source": "metrics", "name": "p95", "query": "p95:trace.server.request{env:${ENV_NAME},service:product-catalog}.rollup(avg, 60)"}],
        "formulas": [{"formula": "p95"}]}]}},
    {"definition": {"type": "timeseries", "title": "Ch 6 · email restarts; last termination reason",
      "requests": [{"response_format": "timeseries", "display_type": "line",
        "queries": [{"data_source": "metrics", "name": "restarts", "query": "max:k8s.container.restarts{k8s.container.name:email}"},
                    {"data_source": "metrics", "name": "oom", "query": "max:kube_pod_container_status_last_terminated_reason{container:email,reason:oomkilled}"}],
        "formulas": [{"formula": "restarts", "alias": "restarts"}, {"formula": "oom", "alias": "last reason OOMKilled"}]}]}}
  ]
}
